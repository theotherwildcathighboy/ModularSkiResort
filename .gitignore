# Generated asset outputs — deterministic (fixed seeds) from assets/blender/ generators;
# regenerate rather than version. The generators + their constants ARE the source.
assets/import/**/*.fbx
assets/import/**/*.png
assets/preview/

# Build outputs
tools/testbridge/Library/
tools/testbridge-mergetag/Library/
mod/SkiResortMod/bin/
mod/SkiResortMod/obj/
mod/SkiResortMod/Library/
# UI module (mod/SkiResortUI, Round U1): installed packages, webpack output, and the cs2/* typings
# that tools/sync-types.js copies from the game install at build time (never committed: the
# game's scaffold carries no license). package-lock.json IS committed.
mod/SkiResortUI/node_modules/
mod/SkiResortUI/build/
mod/SkiResortUI/types/
# Headless test hosts (tests/GladeBatch — net8, links the planner source; spec §3)
tests/**/bin/
tests/**/obj/
tests/**/out/

# Editor/OS noise
*.user
Thumbs.db
desktop.ini

# NOT ignored on purpose (mod/SkiResortMod/Textures/ IS ignored since 2026-08-12, below; a publish build stops
# without its 8 PNGs, mod/SkiResortMod/SkiPublish.targets):
#   gamedata-mirror/             — backup of hand-made prefabs from the game's
#                                  ImportedData (tools/sync-gamedata.ps1)
#   release/                     — listing copy + curated screenshots (not regenerable)

# Per-release test saves (T74, 2026-10-19): city saves are large binaries kept on this machine only;
# the folder's README (what to keep, how to name it) is tracked.
release/saves-by-release/*
!release/saves-by-release/README.md

# Release staging for the Editor's asset package (release review 2026-10-30, B1): the .cok (about 0.8 GB) that publish
# builds copy into the upload (mod/SkiResortMod/SkiPublish.targets). Only the folder's README is tracked.
mod/SkiResortMod/Package/*
!mod/SkiResortMod/Package/README.md

# Python bytecode
__pycache__/
*.pyc

# Stray generator-output staging (same class as assets/import outputs)
assets/staging/

# Local-only by design (user call 2026-08-12): research/docs stay on this machine,
# asset sources and shipped textures are not for a code repo. All texture PNGs are
# deterministic generator output (assets/blender) or re-downloadable (ambientCG).
/docs/
assets/textures/
mod/SkiResortMod/Textures/

# Third-party originals (ROUND-SPEC R20): WHITELIST - everything under assets/external
# stays local (any extension: .blend1, .jpeg, .tga, the Sketchfab .zip ...) except each
# assets/external/<id>/SOURCE.md (author, URL, license, what was archived).
assets/external/**
!assets/external/**/
!assets/external/*/SOURCE.md

# 2026-10-13 cleanup: superseded exports / frames / packs consolidated under assets/archive/ (8+ GB of PNG/FBX; never commit)
assets/archive/

# dotnet tool build output
tools/**/bin/
tools/**/obj/

# Claude Code agent layer (2026-10-24): the working contract, skills and hook settings are private, like docs/, which they
# cite throughout. Local copies stay; the repository never carries them.
/CLAUDE.md
/.claude/

# More editor / OS / tool noise
.vs/
.idea/
.DS_Store
*.log
*.bak
*.orig
*.tmp
npm-debug.log*
