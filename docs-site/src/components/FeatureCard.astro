---
// Starlight's Card, but the heading icon is one of the mod's own images (public/icons/) instead of a built-in glyph.
// Same markup and look as the built-in Card; inside a CardGrid.
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon: string;
  alt: string;
}
const { title, icon, alt } = Astro.props;
---
<article class="card sl-flex">
  <p class="title sl-flex">
    <Icon name={icon} alt={alt} size={40} />
    <span>{title}</span>
  </p>
  <div class="body"><slot /></div>
</article>

<style>
  @layer starlight.components {
    .card {
      --card-border: var(--sl-color-purple);
      border: 1px solid var(--sl-color-gray-5);
      background-color: var(--sl-color-black);
      padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
      flex-direction: column;
      gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
    }
    .card:nth-child(4n + 1) { --card-border: var(--sl-color-orange); }
    .card:nth-child(4n + 3) { --card-border: var(--sl-color-green); }
    .card:nth-child(4n + 4) { --card-border: var(--sl-color-red); }
    .title {
      font-weight: 600;
      font-size: var(--sl-text-h4);
      color: var(--sl-color-white);
      line-height: var(--sl-line-height-headings);
      gap: 1rem;
      align-items: center;
    }
    .card :global(.icon) {
      margin: 0;
      border: 1px solid var(--card-border);
      flex-shrink: 0;
    }
    .card .body {
      margin: 0;
      font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
    }
  }
</style>
