---
// A real in-game screenshot from public/shots/, or, without `src`, a labeled gray box for a shot not taken yet.
// Never a mock-up: the box says what the real picture must show, and the label doubles as the image's alt text.
// A click opens the screenshot larger in a dialog; without JavaScript the link opens the image file itself.
interface Props {
  label: string;
  src?: string;
  ratio?: string;
}
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';

const { label, src, ratio = '16 / 9' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// public/shots/ of this site. The build runs in docs-site/ (the first path). A dev server started with --root runs
// elsewhere, and there this file is still at its source path (the second path).
function shotPath(name: string): string {
  const fromCwd = join(process.cwd(), 'public', 'shots', name);
  if (existsSync(fromCwd)) return fromCwd;
  return fileURLToPath(new URL(`../../public/shots/${name}`, import.meta.url));
}

// The file's real pixel size (from the JPEG frame header), so the page keeps the image's shape before it loads.
// A file that cannot be read keeps the 16:9 default.
function jpegSize(name: string): [number, number] {
  try {
    const b = readFileSync(shotPath(name));
    let i = 2;
    while (i + 9 < b.length && b[i] === 0xff) {
      const marker = b[i + 1];
      if (marker === 0xff) { i++; continue; }
      const frame = marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc;
      if (frame) return [b.readUInt16BE(i + 7), b.readUInt16BE(i + 5)];
      i += 2 + b.readUInt16BE(i + 2);
    }
  } catch {
    // fall through to the default
  }
  return [1920, 1080];
}
const [width, height] = src ? jpegSize(src) : [1920, 1080];
// A native crop of a panel is never drawn larger than its own pixels.
const cap = width < 1200 ? `max-width: ${width}px` : undefined;
---
{src ? (
  <a class="shot-link" href={`${base}/shots/${src}`} data-shot-zoom>
    <img class="shot-img" src={`${base}/shots/${src}`} alt={label} width={width} height={height} style={cap} loading="lazy" decoding="async" />
  </a>
) : (
  <figure class="shot" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Screenshot to come: ${label}`}>
    <figcaption>
      <strong>Screenshot to come</strong>
      <span>{label}</span>
    </figcaption>
  </figure>
)}

<script>
  // One gallery per page: every screenshot on the page, in page order. Arrows, the arrow keys or a swipe step
  // through them, wrapping at the ends. A click outside the arrows, Esc or the close button closes it.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-shot-zoom]'));
  if (links.length) {
    const dialog = document.createElement('dialog');
    dialog.className = 'shot-zoom';
    dialog.innerHTML =
      '<button type="button" class="shot-zoom-close" aria-label="Close">&times;</button>' +
      '<button type="button" class="shot-zoom-prev" aria-label="Previous screenshot">&#8249;</button>' +
      '<button type="button" class="shot-zoom-next" aria-label="Next screenshot">&#8250;</button>' +
      '<img alt="" /><p><span class="shot-zoom-count"></span><span class="shot-zoom-text"></span></p>';
    if (links.length === 1) dialog.dataset.single = '';
    document.body.append(dialog);
    const image = dialog.querySelector('img')!;
    const count = dialog.querySelector<HTMLElement>('.shot-zoom-count')!;
    const text = dialog.querySelector<HTMLElement>('.shot-zoom-text')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const link = links[current];
      const alt = link.querySelector('img')?.alt ?? '';
      image.src = link.href;
      image.alt = alt;
      count.textContent = `${current + 1} / ${links.length}`;
      text.textContent = alt;
      // Load the neighbors so a step shows at once.
      if (links.length > 1) {
        new Image().src = links[(current + 1) % links.length].href;
        new Image().src = links[(current - 1 + links.length) % links.length].href;
      }
    };
    const step = (by: number) => (event: Event) => {
      event.stopPropagation();
      show(current + by);
    };

    dialog.querySelector('.shot-zoom-prev')!.addEventListener('click', step(-1));
    dialog.querySelector('.shot-zoom-next')!.addEventListener('click', step(1));
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => image.removeAttribute('src'));
    dialog.addEventListener('keydown', (event) => {
      if (links.length < 2) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
    });

    // Swipe on touch screens: a mostly sideways move of 40 px or more steps; a tap still closes.
    let startX = 0;
    let startY = 0;
    let swiped = false;
    dialog.addEventListener('touchstart', (event) => {
      startX = event.touches[0].clientX;
      startY = event.touches[0].clientY;
      swiped = false;
    }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const dx = event.changedTouches[0].clientX - startX;
      const dy = event.changedTouches[0].clientY - startY;
      if (links.length > 1 && Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) {
        swiped = true;
        show(current + (dx < 0 ? 1 : -1));
      }
    });
    dialog.addEventListener('click', (event) => {
      if (swiped) { event.stopImmediatePropagation(); swiped = false; }
    }, { capture: true });

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        show(index);
        dialog.showModal();
      });
    });
  }
</script>
