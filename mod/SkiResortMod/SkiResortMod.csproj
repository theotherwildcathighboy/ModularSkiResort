<Project Sdk="Microsoft.NET.Sdk">

	<!--
	Official Cities: Skylines II mod project (generated from the `dotnet new csiimod` template,
	then extended). Target framework (net48), LangVersion (9.0), game-DLL search path
	(CSII_MANAGEDPATH), the Unity.Entities source generators, ModPostProcessor and the
	deploy-to-CSII_LOCALMODSPATH step all come from Mod.props / Mod.targets in CSII_TOOLPATH.
	Do not add game references by path; add them by simple name so Mod.props resolves them.
	-->

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>

		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>

		<!--
		SAVE IDENTITY (Systems/SkiRunBinding.cs:50-57). A save names each of our persisted components by its AssemblyQualifiedName, which
		carries "Version=" + this AssemblyVersion (Colossal.Core ComponentSerializer.cs:33-41). Whether Mono resolves a saved
		name whose version differs is unverified, so the version never changes: AssemblyVersion is PINNED at 1.0.0.0 FOREVER.
		It is also the third tie-break when two copies of the DLL are installed (Colossal.IO.AssetDatabase ExecutableAsset.cs:149, :189).
		The release number moves in FileVersion (below) and in Properties/PublishConfiguration.xml ModVersion. tests/SaveBatch SL-AV
		reads the built DLL and fails on any other AssemblyVersion (SaveLayouts.PinnedAssemblyVersion).
		-->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<!-- Moves with each release (free; nothing persisted reads it). -->
		<FileVersion>1.0.0.0</FileVersion>
	</PropertyGroup>

	<!--Imports must be after PropertyGroup block-->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<Reference Include="Game">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>
		<!-- TextureAsset implements interfaces declared in Colossal.AssetPipeline; the
		     compiler needs it resolvable to use TextureAsset generics (SkiRunSplatSystem). -->
		<Reference Include="Colossal.AssetPipeline">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>
		<!--
		The tooltip widgets (Game.UI.Tooltip StringTooltip / IntTooltip, via Game.UI.Widgets.Widget) implement interfaces declared in
		Colossal.UI.Binding; the compiler needs it resolvable for SkiRunTooltipSystem. Present in %CSII_MANAGEDPATH% as Colossal.UI.Binding.dll.
		-->
		<Reference Include="Colossal.UI.Binding">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>
		<!-- NativeQuadTree / INativeQuadTreeIterator / NativeValue are not defined in Game.dll:
		     SearchSystem.GetStaticSearchTree returns NativeQuadTree (SearchSystem.cs:421) and
		     OverlayRenderSystem.Buffer holds a NativeValue (OverlayRenderSystem.cs:116). Used
		     by the glade tool (SkiGladeToolSystem: thinning candidates, overlay). -->
		<Reference Include="Colossal.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>
		<!--
		UnityEngine.Rendering.DebugUI (the developer-menu widget model the game's own debug tabs are built from) lives in the
		render-pipeline core assembly. Used only by the Ski Resort developer-menu tab (ChairPinSystem.Debug.cs).
		-->
		<Reference Include="Unity.RenderPipelines.Core.Runtime">
			<Private>false</Private>
		</Reference>
		<!-- Texture2D.LoadImage lives in the ImageConversion module (SkiRunSplatSystem
		     loads the run-material PNGs at runtime). -->
		<Reference Include="UnityEngine.ImageConversionModule">
			<Private>false</Private>
		</Reference>
		<!-- GUIUtility.systemCopyBuffer (the clipboard) lives in the IMGUI module: Options > Diagnostics > Copy diagnostics. -->
		<Reference Include="UnityEngine.IMGUIModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
		<!-- IProxyAction declares event Action<ProxyAction, InputActionPhase> onInteraction
		     (IProxyAction.cs:12) and ToolBaseSystem uses UnityEngine.InputSystem; the glade
		     tool + hotkey system touch ProxyAction, so the compiler may need the type
		     (CS0012 risk, unverified without it). -->
		<Reference Include="Unity.InputSystem">
			<Private>false</Private>
		</Reference>
		<!--
		SkiRunLabelSystem builds the run-name labels from the game's own TextMeshPro text mesh (OverlayRenderSystem.GetTextMesh returns a
		TMPro.TextMeshPro). Reference only; nothing is copied.
		-->
		<Reference Include="Unity.TextMeshPro">
			<Private>false</Private>
		</Reference>
		<!-- TMP_Text derives from UnityEngine.UI.MaskableGraphic: the compiler needs the assembly (CS0012) for any TMP member. -->
		<Reference Include="UnityEngine.UI">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

	<!-- Run-material PNGs (SkiRunSplatSystem texture contract). Copied to $(OutDir)\Textures,
	     which the stock DeployWIP target then mirrors into the Mods folder recursively.
	     The folder may not exist yet while the textures are being authored — an empty glob
	     is fine, and the system logs missing files and stays inert until they appear. -->
	<ItemGroup>
		<None Include="Textures\**\*.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Notification icons made in code (LiftLineIconAsset): the PNG is the world icon's pixels, the SVG the info panel's icon
	     (coui://ui-mods/SkiResortMod-icons/...: the folder name is unique because coui://ui-mods/ is ONE host shared by every
	     mod folder, ModManager.cs:468-479). Copied to $(OutDir)\SkiResortMod-icons, deployed with the rest of OutDir. -->
	<ItemGroup>
		<None Include="Icons\*.svg;Icons\*.png" Link="SkiResortMod-icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
	The toolchain's ModPostProcessor.exe targets the .NET 6 runtime, which is not installed on
	this machine (only .NET 8 is). Its runtimeconfig.json has no rollForward policy, so the run
	fails with "You must install or update .NET". Overriding the stock RunModPostProcessor
	target — the exact customization mechanism documented at the top of Mod.targets — reruns the
	same command with DOTNET_ROLL_FORWARD=LatestMajor, letting it run on the installed .NET 8.
	On a machine that has .NET 6 the variable is a no-op, so this stays portable.
	-->
	<!-- BeforeTargets="DeployWIP" restores the stock ordering (post-process, then deploy):
	     redefining the target here moves its declaration after DeployWIP, and MSBuild runs
	     same-hook targets in declaration order, which would deploy an unprocessed DLL. -->
	<Target Name="RunModPostProcessor" AfterTargets="AfterBuild" BeforeTargets="DeployWIP" Condition="'$(NeedBuild)'">
		<Error Condition="!Exists('$(ModPostProcessorFullPath)')" Text="Post processor not found, please check the path: $(ModPostProcessorFullPath)" />
		<Message Text="Run post processor (with DOTNET_ROLL_FORWARD=LatestMajor): $(ModPostProcessorArgs)" Importance="high" />
		<Exec Command="$(ModPostProcessorArgs)" LogStandardErrorAsError="true" EnvironmentVariables="DOTNET_ROLL_FORWARD=LatestMajor" />
	</Target>

	<!--
	===============================================================================================
	Ski Resort UI module (mod/SkiResortUI): build, build stamp, deploy.
	
	  SkiUiBuild    (before BeforeBuild) when mod/SkiResortUI/node_modules exists: generates ONE new build stamp and runs
	                `npm run build` there (sync-types, webpack, the tools/check-bundle.js gate) with it in SKI_BUILD_STAMP; webpack
	                compiles it into the bundle (__BUILD_STAMP__) and writes build\.ui-stamp. Incremental: skipped while no UI input
	                (sources, configs, root LocaleEN.cs, the C# files listed below, tools\contract.lock, the game's typings and UI
	                index.js) is newer than the bundle AND build\.gate-pass exists. A failing UI build FAILS this build before
	                anything compiles; nothing is deployed and the Mods folder keeps the previous build (a broken bundle can blank
	                every mod's UI).
	  GATE MARKER   build\.gate-pass records the gate result: webpack deletes it on every emit, check-bundle deletes it when it
	                starts and writes it (= the stamp) only on PASS, and SkiUiBuildFailedHint deletes it and .ui-stamp on any
	                failure. It is an Output of SkiUiBuild (missing = the gate reruns), and SkiBuildStamp and SkiUiDeploy raise an
	                error unless it exists and equals .ui-stamp. So a rejected bundle never reaches the DLL or the Mods folder, on
	                the failing build or any later one, however build\ got there (dotnet build, npm run build/dev, npm run check).
	  SkiBuildStamp (before CoreCompile; every build, design-time builds included): compiles the stamp of the GATED bundle in
	                build\ into SkiResortMod.BuildStamp.Value (obj\...\SkiBuildStamp.g.cs, rewritten only when the value changes,
	                so an unchanged UI forces no recompile). The C# hub compares it with the bundle's uiHello. No UI: "no-ui"
	                (also in a design-time build that finds an ungated bundle: no error there).
	  SkiUiDeploy   (after DeployWIP, which deletes the deploy folder first, Mod.targets:106-113): copies build\ (minus
	                .ui-stamp and .gate-pass) beside the DLL, after re-checking the marker and that build\ still holds the stamp
	                compiled into the DLL. An error here leaves the new DLL deployed WITHOUT a bundle (logged in game as "UI
	                module present: False"), never a mismatched or ungated one. Publishing uploads the deploy folder
	                (Mod.targets:122, :148), so the bundle ships with no further change.
	  No node_modules (a fresh clone before `npm ci`) or -p:SkipUi=true: the DLL builds and deploys exactly as before and ONE
	  line says the UI is absent (a warning when node_modules is missing).
	Ordering: declared after the RunModPostProcessor override above and hooked only on BeforeBuild, CoreCompile and DeployWIP, so
	build, post-process, DeployWIP, SkiUiDeploy stays intact. BuildGetFullPaths (Mod.targets, also BeforeTargets="BeforeBuild",
	declared earlier) sets NeedBuild/DeployDir before SkiUiBuild's condition is evaluated.
	===============================================================================================
	-->
	<PropertyGroup>
		<SkiUiDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\SkiResortUI'))</SkiUiDir>
		<SkiUiBuildDir>$(SkiUiDir)\build</SkiUiBuildDir>
		<SkiUiStampFile>$(SkiUiBuildDir)\.ui-stamp</SkiUiStampFile>
		<!-- Written by tools/check-bundle.js only on PASS (content = the stamp); header "GATE MARKER". -->
		<SkiUiGateFile>$(SkiUiBuildDir)\.gate-pass</SkiUiGateFile>
		<SkiCsiiInstall>$([System.Environment]::GetEnvironmentVariable('CSII_INSTALLATIONPATH', 'EnvironmentVariableTarget.User'))</SkiCsiiInstall>
		<SkiUiEnabled>false</SkiUiEnabled>
		<SkiUiEnabled Condition="'$(SkipUi)' != 'true' And Exists('$(SkiUiDir)\node_modules')">true</SkiUiEnabled>
	</PropertyGroup>

	<ItemGroup Condition="'$(SkiUiEnabled)' == 'true'">
		<SkiUiInput Include="$(SkiUiDir)\src\**\*" />
		<SkiUiInput Include="$(SkiUiDir)\tools\*.js" />
		<SkiUiInput Include="$(SkiUiDir)\package.json;$(SkiUiDir)\package-lock.json;$(SkiUiDir)\webpack.config.js;$(SkiUiDir)\tsconfig.json;$(SkiUiDir)\mod.json" />
		<!-- check-bundle lints the SkiResort.Hub.* strings here and parses the game's runtime exports. -->
		<SkiUiInput Include="$(MSBuildProjectDirectory)\LocaleEN.cs" />
		<!--
		Contract rules 1-3: the gate also matches the hub system's binding / trigger literals and TypeBegin blocks against
		bindings.ts and reads tools/contract.lock, so a C#-only change of a name or a field must re-run it. The *.lock wildcard matches
		nothing (and adds no input) until the lock file exists.
		-->
		<SkiUiInput Include="$(MSBuildProjectDirectory)\Systems\SkiResortHubUISystem.cs" />
		<!--
		Gate rule R17: the gate compares these files' enums with bindings.ts, so a C#-only change of a compared enum must re-run it.
		SkiDayRules.cs is appended: its top-level SkiDayLimit is the SKI_DAY_LIMIT pair.
		-->
		<SkiUiInput Include="$(MSBuildProjectDirectory)\Systems\HubRules.cs;$(MSBuildProjectDirectory)\Systems\EntityRef.cs;$(MSBuildProjectDirectory)\Systems\SkiMoneyRules.cs;$(MSBuildProjectDirectory)\Systems\SkiDayRules.cs" />
		<!-- check-bundle R16 parses the NAMES and BUILD-ITEMS blocks of Systems\SkiCatalog.cs, so a SkiCatalog-only edit must re-run the gate. -->
		<SkiUiInput Include="$(MSBuildProjectDirectory)\Systems\SkiCatalog.cs" />
		<!--
		tools/test-hub-rules.js (gate R18) compares bindings.ts HISTORY_FLAG with the HistoryFlags constants of this file, so a
		C#-only flag change must re-run the gate.
		-->
		<SkiUiInput Include="$(MSBuildProjectDirectory)\Systems\SkiResortHistory.cs" />
		<SkiUiInput Include="$(SkiUiDir)\tools\*.lock" />
		<SkiUiInput Include="$(SkiCsiiInstall)\Cities2_Data\Content\Game\.ModdingToolchain\npx-create-csii-ui-mod\template\types\*.d.ts" Condition="'$(SkiCsiiInstall)' != ''" />
		<SkiUiInput Include="$(SkiCsiiInstall)\Cities2_Data\Content\Game\UI\index.js" Condition="'$(SkiCsiiInstall)' != ''" />
	</ItemGroup>

	<Target Name="SkiUiBuild" BeforeTargets="BeforeBuild"
	        Condition="'$(NeedBuild)' == 'true' And '$(SkiUiEnabled)' == 'true' And '$(DesignTimeBuild)' != 'true'"
	        Inputs="@(SkiUiInput)"
	        Outputs="$(SkiUiStampFile);$(SkiUiGateFile);$(SkiUiBuildDir)\SkiResortMod.mjs;$(SkiUiBuildDir)\SkiResortMod.css">
		<PropertyGroup>
			<SkiNewStamp>$([System.DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss'))-$([System.Guid]::NewGuid().ToString('N').Substring(0, 6))</SkiNewStamp>
		</PropertyGroup>
		<Message Importance="high" Text="SkiResortMod UI: building mod\SkiResortUI (npm run build: sync-types, webpack, check-bundle) with build stamp $(SkiNewStamp)" />
		<Exec Command="npm run build" WorkingDirectory="$(SkiUiDir)"
		      EnvironmentVariables="SKI_BUILD_STAMP=$(SkiNewStamp);CSII_INSTALLATIONPATH=$(SkiCsiiInstall)"
		      StandardOutputImportance="high" StandardErrorImportance="high"
		      CustomErrorRegularExpression="check-bundle: (ERROR|CRASHED)|\[tsl\] ERROR|^ERROR in |sync-types: FAILED" />
		<OnError ExecuteTargets="SkiUiBuildFailedHint" />
	</Target>

	<!-- Belt and braces for failures before the gate ran (sync-types, webpack): no stamp, no marker,
	     so the next build reruns the UI build and nothing from build\ can be reused. -->
	<Target Name="SkiUiBuildFailedHint">
		<Delete Files="$(SkiUiGateFile);$(SkiUiStampFile)" ContinueOnError="true" />
		<Message Importance="high" Text="SkiResortMod UI: the UI build FAILED (see above). Nothing was compiled or deployed by THIS build; build\.gate-pass and build\.ui-stamp are deleted, so later builds rerun the UI build and can never ship the rejected bundle. Fix it, or build the DLL alone with: dotnet build -p:SkipUi=true (the hub UI is then absent)." />
	</Target>

	<Target Name="SkiBuildStamp" BeforeTargets="CoreCompile" DependsOnTargets="PrepareForBuild">
		<PropertyGroup>
			<SkiBuildStampFile>$(IntermediateOutputPath)SkiBuildStamp.g.cs</SkiBuildStampFile>
			<SkiStampValue>no-ui</SkiStampValue>
			<SkiStampUi>false</SkiStampUi>
			<SkiStampRead></SkiStampRead>
		</PropertyGroup>
		<ReadLinesFromFile File="$(SkiUiStampFile)" Condition="'$(SkiUiEnabled)' == 'true' And Exists('$(SkiUiStampFile)') And Exists('$(SkiUiBuildDir)\SkiResortMod.mjs')">
			<Output TaskParameter="Lines" PropertyName="SkiStampRead" />
		</ReadLinesFromFile>
		<ReadLinesFromFile File="$(SkiUiGateFile)" Condition="'$(SkiStampRead)' != '' And Exists('$(SkiUiGateFile)')">
			<Output TaskParameter="Lines" PropertyName="SkiGateRead" />
		</ReadLinesFromFile>
		<PropertyGroup>
			<SkiGateOk>false</SkiGateOk>
			<SkiGateOk Condition="'$(SkiStampRead)' != '' And '$(SkiGateRead.Trim())' == '$(SkiStampRead.Trim())'">true</SkiGateOk>
		</PropertyGroup>
		<!-- Header "GATE MARKER": a bundle that did not pass tools/check-bundle.js never gets compiled in. -->
		<Error Condition="'$(SkiStampRead)' != '' And '$(SkiGateOk)' != 'true' And '$(DesignTimeBuild)' != 'true'"
		       Text="SkiResortMod UI: the bundle in mod\SkiResortUI\build (stamp $(SkiStampRead.Trim())) has NOT passed tools/check-bundle.js (build\.gate-pass is missing or names '$(SkiGateRead.Trim())'). Nothing compiled or deployed. Rebuild the UI: delete mod\SkiResortUI\build and run dotnet build again (or npm run build there), or build the DLL alone with -p:SkipUi=true." />
		<PropertyGroup Condition="'$(SkiGateOk)' == 'true'">
			<SkiStampValue>$(SkiStampRead.Trim())</SkiStampValue>
			<SkiStampUi>true</SkiStampUi>
		</PropertyGroup>
		<Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(SkiStampValue)', '^[A-Za-z0-9._-]{1,64}$'))"
		       Text="SkiResortMod: build stamp '$(SkiStampValue)' read from $(SkiUiStampFile) is malformed; delete mod\SkiResortUI\build and rebuild." />
		<!-- One item per generated line: ';' is written %3B, and no line may contain '*', '?', '$(' or '@(' (MSBuild item syntax). -->
		<ItemGroup>
			<SkiStampLine Include="// &lt;auto-generated&gt; by SkiResortMod.csproj, target SkiBuildStamp. Do not edit%3B lives in obj\, never committed." />
			<SkiStampLine Include="namespace SkiResortMod" />
			<SkiStampLine Include="{" />
			<SkiStampLine Include="/// &lt;summary&gt;The build stamp shared by this DLL and the UI bundle deployed beside it" />
			<SkiStampLine Include="/// (mod/SkiResortUI, webpack DefinePlugin __BUILD_STAMP__, read by the hub's uiHello).&lt;/summary&gt;" />
			<SkiStampLine Include="public static class BuildStamp" />
			<SkiStampLine Include="{" />
			<SkiStampLine Include="/// &lt;summary&gt;Equals the bundle's BUNDLE_STAMP when both came out of the same build%3B" />
			<SkiStampLine Include="/// &quot;no-ui&quot; when this DLL was built without the UI module.&lt;/summary&gt;" />
			<SkiStampLine Include="public const string Value = &quot;$(SkiStampValue)&quot;%3B" />
			<SkiStampLine Include="/// &lt;summary&gt;True when this build deployed a UI bundle beside the DLL.&lt;/summary&gt;" />
			<SkiStampLine Include="public static readonly bool UiBundled = $(SkiStampUi)%3B" />
			<SkiStampLine Include="}" />
			<SkiStampLine Include="}" />
		</ItemGroup>
		<WriteLinesToFile File="$(SkiBuildStampFile)" Lines="@(SkiStampLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(SkiBuildStampFile)" />
			<FileWrites Include="$(SkiBuildStampFile)" />
		</ItemGroup>
		<Message Importance="high" Text="SkiResortMod: build stamp $(SkiStampValue) compiled into the DLL as SkiResortMod.BuildStamp.Value (UI bundle: $(SkiStampUi))" />
	</Target>

	<Target Name="SkiUiDeploy" AfterTargets="DeployWIP" Condition="'$(NeedBuild)' == 'true'">
		<ItemGroup Condition="'$(SkiUiEnabled)' == 'true'">
			<SkiUiDeployFile Include="$(SkiUiBuildDir)\**\*" Exclude="$(SkiUiStampFile);$(SkiUiGateFile)" />
		</ItemGroup>
		<Error Condition="'$(SkiUiEnabled)' == 'true' And (!Exists('$(SkiUiBuildDir)\SkiResortMod.mjs') Or !Exists('$(SkiUiBuildDir)\SkiResortMod.css'))"
		       Text="SkiResortMod UI: mod\SkiResortUI\build\SkiResortMod.mjs or .css is missing although node_modules exists. Run npm run build there, or build with -p:SkipUi=true." />
		<!-- Header "GATE MARKER": re-read both files here, after the compile - build\ must still hold the
		     gated bundle whose stamp is in the DLL (e.g. not one an `npm run dev` wrote meanwhile). -->
		<ReadLinesFromFile File="$(SkiUiStampFile)" Condition="'$(SkiUiEnabled)' == 'true' And Exists('$(SkiUiStampFile)')">
			<Output TaskParameter="Lines" PropertyName="SkiDeployStamp" />
		</ReadLinesFromFile>
		<ReadLinesFromFile File="$(SkiUiGateFile)" Condition="'$(SkiUiEnabled)' == 'true' And Exists('$(SkiUiGateFile)')">
			<Output TaskParameter="Lines" PropertyName="SkiDeployGate" />
		</ReadLinesFromFile>
		<Error Condition="'$(SkiUiEnabled)' == 'true' And ('$(SkiDeployStamp.Trim())' == '' Or '$(SkiDeployGate.Trim())' != '$(SkiDeployStamp.Trim())')"
		       Text="SkiResortMod UI: NOT deployed - the bundle in mod\SkiResortUI\build (stamp '$(SkiDeployStamp.Trim())') has not passed tools/check-bundle.js (build\.gate-pass: '$(SkiDeployGate.Trim())'). The new DLL is deployed without the hub UI. Delete mod\SkiResortUI\build and rebuild." />
		<Error Condition="'$(SkiUiEnabled)' == 'true' And '$(SkiDeployStamp.Trim())' != '$(SkiStampValue)'"
		       Text="SkiResortMod UI: NOT deployed - mod\SkiResortUI\build changed after the DLL was compiled (bundle stamp '$(SkiDeployStamp.Trim())', DLL stamp '$(SkiStampValue)'). The new DLL is deployed without the hub UI. Stop npm run dev and rebuild." />
		<Copy Condition="'$(SkiUiEnabled)' == 'true'" SourceFiles="@(SkiUiDeployFile)"
		      DestinationFiles="@(SkiUiDeployFile->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Message Condition="'$(SkiUiEnabled)' == 'true'" Importance="high"
		         Text="SkiResortMod UI: deployed @(SkiUiDeployFile->Count()) file(s), build stamp $(SkiStampValue) -> $(DeployDir)" />
		<Message Condition="'$(SkiUiEnabled)' != 'true' And '$(SkipUi)' == 'true'" Importance="high"
		         Text="SkiResortMod UI: ABSENT (-p:SkipUi=true) - the DLL is deployed without the hub UI (build stamp $(SkiStampValue))." />
		<Warning Condition="'$(SkiUiEnabled)' != 'true' And '$(SkipUi)' != 'true'"
		         Text="SkiResortMod UI: ABSENT - mod\SkiResortUI\node_modules is missing (run npm ci there once). The DLL is deployed without the hub UI (build stamp $(SkiStampValue))." />
	</Target>

	<!--
	Publish builds only (PublishNewMod / PublishNewVersion, or the dry run -p:SkiPublishDryRun=true): the Editor's .cok from
	Package\, the Write Everywhere layouts, the profile-path strip and tools\release-check.ps1, after DeployWIP and SkiUiDeploy.
	Imported last so its DeployWIP hook runs after SkiUiDeploy. Every other build is unchanged. Details: SkiPublish.targets.
	-->
	<Import Project="SkiPublish.targets" />

</Project>
