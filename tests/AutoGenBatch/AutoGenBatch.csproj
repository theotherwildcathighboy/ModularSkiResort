<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the Resort Planner: the runs-first planner (RunsFirstPlanner*.cs), its realizer (RunsFirstRealizer*.cs),
    the tool scan job and the shared plan types, on synthetic terrains and the real heightmap fixtures. Run from the ModularSkiResort root:
    see the one-line command in the Program.cs header (XML comments cannot hold a double dash).
    Clone of tests/GradeBatch/GradeBatch.csproj: lives OUTSIDE mod/SkiResortMod (the mod csproj globs **/*.cs), LangVersion pinned
    to the mod's 9.0, UnityMathematics.NoDeps 1.3.2 = the toolchain's com.unity.mathematics@1.3.2.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>AutoGenBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Terrain.cs" />
    <Compile Include="QuickRunsTests.cs" />
    <Compile Include="Heightmap.cs" />
