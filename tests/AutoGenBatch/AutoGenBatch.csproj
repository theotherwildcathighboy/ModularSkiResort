<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the Quick runs planner: mod/SkiResortMod/Systems/SkiRunAutoPlanner*.cs (field, routing, selection,
    junctions, kinds, refusal ladder) on synthetic terrains and the SlopeBatch field captures. Run from the ModularSkiResort root:
    see the one-line command in the Program.cs header (XML comments cannot hold a double dash).
    Clone of tests/GradeBatch/GradeBatch.csproj: lives OUTSIDE mod/SkiResortMod (the mod csproj globs **/*.cs), LangVersion pinned
    to the mod's 9.0, UnityMathematics.NoDeps 1.3.2 = the toolchain's com.unity.mathematics@1.3.2.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>AutoGenBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Terrain.cs" />
    <Compile Include="Captures.cs" />
    <Compile Include="QuickRunsTests.cs" />
    <Compile Include="Fill.cs" />
    <Compile Include="Field.cs" />
    <Compile Include="V1Golden.cs" />
    <Compile Include="PlanTypes.cs" />
    <Compile Include="Heightmap.cs" />
    <Compile Include="V2Fixtures.cs" />
    <Compile Include="V2Metrics.cs" />
    <Compile Include="V2Tests.cs" />
    <Compile Include="WorkerTests.cs" />
    <Compile Include="TerrainTests.cs" />
    <Compile Include="LiftTests.cs" />
    <Compile Include="FanTests.cs" />
    <Compile Include="FlowTests.cs" />
    <Compile Include="RunsFirst.cs" />
    <Compile Include="RunsFirst.Lifts.cs" />
    <Compile Include="RunsFirst.Score.cs" />
    <Compile Include="RunsFirst.Plan.cs" />
    <Compile Include="RunsFirst.Graph.cs" />
    <Compile Include="RunsFirst.Beginner.cs" />
    <Compile Include="RunsFirst.Network.cs" />
    <Compile Include="RunsFirst.Fill.cs" />
    <Compile Include="RunsFirst.Cover.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.cs" Link="SkiRunAutoPlanner.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Select.cs" Link="SkiRunAutoPlanner.Select.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Kernels.cs" Link="SkiRunAutoPlanner.Kernels.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Snapshot.cs" Link="SkiRunAutoPlanner.Snapshot.cs" />
    <!-- Resort Planner (v2) files: the types and one file per stage-A task (A0 wrote the stubs) -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Plan.cs" Link="SkiRunAutoPlanner.Plan.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Terrain.cs" Link="SkiRunAutoPlanner.Terrain.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Pods.cs" Link="SkiRunAutoPlanner.Pods.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Lifts.cs" Link="SkiRunAutoPlanner.Lifts.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Fans.cs" Link="SkiRunAutoPlanner.Fans.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Flow.cs" Link="SkiRunAutoPlanner.Flow.cs" />
    <!-- The rater and classifier the labels come from; GradePath / GradeRibbon for centerlines and outlines -->
