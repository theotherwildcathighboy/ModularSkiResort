    <!-- The Quick runs tool rules, the link rule LinkMeters aliases, the bind fees -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\QuickRunsRules.cs" Link="QuickRunsRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\QuickRunsPlanRules.cs" Link="QuickRunsPlanRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftServedRule.cs" Link="LiftServedRule.cs" />
