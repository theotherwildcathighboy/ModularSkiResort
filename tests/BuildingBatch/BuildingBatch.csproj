<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the TOP-LEVEL resort buildings (T10 D1 option A, DECISIONS 308): T100 the ski school (2026-10-19,
    as tests/SchoolBatch), T113 the five lodges and both patrol huts (2026-10-20, renamed BuildingBatch). SchoolLinkRules.cs
    (attribution, the one count rule, the link-log diff, D3 AreaEfficiency) and the invariant "a linked top-level school
    yields the same schoolValue / lessons / problem rows as the child did", plus the per-building mirror gate P1-P10 over
    all eight prefabs (no ServiceUpgrade; ServiceObject + PlaceableObject + CityServiceBuilding + Park; cost / XP / jobs /
    upkeep equal to the catalog row; roadless rows demand nothing; mesh CID resolves; door spawn rows). Run from the
    ModularSkiResort root:
      see the one-line command in the Program.cs header (XML comments cannot hold a double dash)
    Own host (ResortBatch and LiftBatch belong to other sessions). Lives OUTSIDE mod/SkiResortMod on purpose: the mod
    csproj globs **/*.cs. LangVersion pinned to the mod's 9.0; net48 APIs are NOT gated here (the mod build is the gate).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>BuildingBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortIndex.cs" Link="SkiResortIndex.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SchoolLinkRules.cs" Link="SchoolLinkRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\MountainJobsRules.cs" Link="MountainJobsRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortScore.cs" Link="SkiResortScore.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SchoolRule.cs" Link="SchoolRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\PatrolRule.cs" Link="PatrolRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\HubRules.cs" Link="HubRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiMoneyRules.cs" Link="SkiMoneyRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortLedger.cs" Link="SkiResortLedger.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunRatingRules.cs" Link="SkiRunRatingRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
