<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the top-level resort buildings: SchoolLinkRules.cs (attribution, the one count rule, the link-log diff,
    AreaEfficiency) and the invariant that a linked top-level school yields the same schoolValue / lessons / problem rows as a
    child did, plus the per-building mirror gate P1-P10 over all eight prefabs (no ServiceUpgrade; ServiceObject + PlaceableObject +
    CityServiceBuilding + Park; cost / XP / jobs / upkeep equal to the catalog row; roadless rows demand nothing; mesh CID resolves;
    door spawn rows). Run from the ModularSkiResort root: see the one-line command in the Program.cs header.
    Lives OUTSIDE mod/SkiResortMod on purpose: the mod csproj globs **/*.cs. LangVersion pinned to the mod's 9.0; net48 APIs are
    NOT gated here (the mod build is the gate).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>BuildingBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortIndex.cs" Link="SkiResortIndex.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SchoolLinkRules.cs" Link="SchoolLinkRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\MountainJobsRules.cs" Link="MountainJobsRules.cs" />
    <!-- Off-season half staffing, OS1-OS6. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\OffSeasonRules.cs" Link="OffSeasonRules.cs" />
    <Compile Include="OffSeasonTests.cs" />
    <!-- Road-optional lodges and the job carrier, LS1-LS13 and LC1-LC6: the chain walks real RunLinks. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LodgeSupplyRule.cs" Link="LodgeSupplyRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftServedRule.cs" Link="LiftServedRule.cs" />
    <Compile Include="LodgeSupplyTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortScore.cs" Link="SkiResortScore.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SchoolRule.cs" Link="SchoolRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\PatrolRule.cs" Link="PatrolRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\HubRules.cs" Link="HubRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiMoneyRules.cs" Link="SkiMoneyRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortLedger.cs" Link="SkiResortLedger.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunRatingRules.cs" Link="SkiRunRatingRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
