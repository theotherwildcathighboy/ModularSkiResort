<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for mod/SkiResortMod/Systems/SkiGladePlanner.cs.
    Run from the ModularSkiResort root: see the one-line command in the Program.cs header.
    Lives OUTSIDE mod/SkiResortMod on purpose: the mod csproj globs **/*.cs, so a test host under it would be compiled into
    the net48 mod DLL. LangVersion pinned to the mod's 9.0 (Mod.props:8) so newer syntax in the linked planner fails here too;
    net48 APIs are NOT gated here (net8 has Math.Clamp etc.); the mod build is the net48 API gate.
    UnityMathematics.NoDeps 1.3.2 matches the toolchain's com.unity.mathematics@1.3.2.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>GladeBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!--
    The pure composition and hover-log files are linked as source too; ApplySim.cs drives Compose through a test-local world and
    runs density-level sequences (levels, walks, caps, the two field-sized fixtures) judged by an independent recount.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ComposeTests.cs" />
    <Compile Include="ApplySim.cs" />
    <Compile Include="HoverLogTests.cs" />
    <Compile Include="AttemptCapTests.cs" />
    <Compile Include="PinTests.cs" />
    <Compile Include="FillerTests.cs" />
    <Compile Include="EdgeBandTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiGladePlanner.cs" Link="SkiGladePlanner.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiGladeCompose.cs" Link="SkiGladeCompose.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiGladeHover.cs" Link="SkiGladeHover.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiGladeTreeLine.cs" Link="SkiGladeTreeLine.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiGladeSpecies.cs" Link="SkiGladeSpecies.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftMoverMath.cs" Link="LiftMoverMath.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
