<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the PURE half of the Cat Track Grading tool:
    mod/SkiResortMod/Systems/CatTrackGrade.cs (path, profile,
    cross-section raster, guards, undo, edit model, input rules). Run from the ModularSkiResort root:
      see the one-line command in the Program.cs header (XML comments cannot hold a double dash)
    Clone of tests/LiftBatch/LiftBatch.csproj: lives OUTSIDE mod/SkiResortMod (the mod csproj globs **/*.cs), LangVersion
    pinned to the mod's 9.0, UnityMathematics.NoDeps 1.3.2 = the toolchain's com.unity.mathematics@1.3.2.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>GradeBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SplitSolve.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\CatTrackGrade.cs" Link="CatTrackGrade.cs" />
    <!-- GR-31: the full solve as one pure function (worker-safe), and the snapshot sampler it reads on the worker -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\CatTrackGradeSolve.cs" Link="CatTrackGradeSolve.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunAutoPlanner.Snapshot.cs" Link="SkiRunAutoPlanner.Snapshot.cs" />
    <!-- GR-18: the tool's default max grade is the run's green-rule limit (SkiRunRatingRules.CatTrackMaxGrade) -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunRatingRules.cs" Link="SkiRunRatingRules.cs" />
    <!-- GR-20: the game's rater on graded terrain (the cat track's own band, a crossed run's band before / after) -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiSlopeClassifier.cs" Link="SkiSlopeClassifier.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunRater.cs" Link="SkiRunRater.cs" />
    <!-- GR-30: the groomer's centerline over the outlines the tool really generates -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\GroomerCenterline.cs" Link="GroomerCenterline.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
