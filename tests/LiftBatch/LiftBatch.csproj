<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the PURE lift files (LiftCensus, StationAlign, LiftReconnectEpisodes, the loop topology and hold, the
    served rule, the tower planner, the lift-line edit model and more), linked from mod/SkiResortMod/Systems and never copied.
    Run from the ModularSkiResort root: see the one-line command in the Program.cs header.
    Lives OUTSIDE mod/SkiResortMod on purpose: the mod csproj globs **/*.cs, so a test host under it would be compiled into
    the net48 mod DLL. LangVersion pinned to the mod's 9.0 (Mod.props) so newer syntax in the linked files fails here too;
    net48 APIs are NOT gated here (net8 has Math.Clamp etc.); the mod build is the net48 API gate.
    UnityMathematics.NoDeps 1.3.2 matches the toolchain's com.unity.mathematics@1.3.2.
    The loop cache's GEOMETRY needs Game types (Colossal.Mathematics, PathNode, Entity) and is not tested here; its topology pass is
    the pure LiftLoopTopology.cs (LoopCacheTests.cs). SkiCatalog (pure) is linked because StationAlign and LiftServedRule alias it;
    CatalogTests.cs holds CT-1 to CT-16 (sanity, frozen-name oracle, NAMES and hub-literal text parses, resolver lifetime, the
    carriers.json parse CT-11 with System.Text.Json, the gamedata-mirror drift CT-12, pending tokens CT-13, the BUILD-ITEMS table
    CT-14, EvenSpacing CT-15 and its sanity twin CT-16); LiftTypeTests.cs holds LT-1 to LT-10. PowerGateTests.cs (PG-0 to PG-4)
    and LoopHoldTests.cs (LH-1 to LH-4) cover the pure LiftLoopHold.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>LiftBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftCensus.cs" Link="LiftCensus.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\StationAlign.cs" Link="StationAlign.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftReconnectEpisodes.cs" Link="LiftReconnectEpisodes.cs" />
    <!-- The served rule and the power predicate. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftServedRule.cs" Link="LiftServedRule.cs" />
    <!-- LiftClosedRule.NoOpenRunShare reads SkiMoneyRules' two shares. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiMoneyRules.cs" Link="SkiMoneyRules.cs" />
    <!-- The pure prefab catalog (StationAlign and LiftServedRule alias it). -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="CatalogTests.cs" />
    <!-- The typed census / served-rule rows. -->
    <Compile Include="LiftTypeTests.cs" />
    <!-- The loop cache's pure topology and the shuttle profile. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLoopTopology.cs" Link="LiftLoopTopology.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
    <Compile Include="LoopCacheReference.cs" />
    <Compile Include="LoopCacheTests.cs" />
    <Compile Include="ShuttleTests.cs" />
    <!-- The pure loop hold and the power-gate / hold tests. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLoopHold.cs" Link="LiftLoopHold.cs" />
    <!-- The station LV icon rule, LoopHoldTests LV-1..LV-4. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\StationLvRule.cs" Link="StationLvRule.cs" />
    <Compile Include="PowerGateTests.cs" />
    <Compile Include="LoopHoldTests.cs" />
    <!-- Runs linked to a served run are served. -->
    <Compile Include="ServedLinkTests.cs" />
    <!-- The pure tower planner and its tests. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftTowerPlanner.cs" Link="LiftTowerPlanner.cs" />
    <Compile Include="LiftPlannerTests.cs" />
    <!-- The lift-line tool's pure edit model. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLineEdit.cs" Link="LiftLineEdit.cs" />
    <!-- The one lift tool's input rules + undo. -->
    <Compile Include="LiftToolInputTests.cs" />
    <!-- Per-tower number tiles, the pure core. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\TowerNumberTiles.cs" Link="TowerNumberTiles.cs" />
    <Compile Include="TowerNumberTests.cs" />
    <!-- The far-loop pace, bounds cadence and lane scope. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftMoverMath.cs" Link="LiftMoverMath.cs" />
    <Compile Include="LoopPaceTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
