<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the PURE lift files:
    LiftCensus.cs, StationAlign.cs, LiftReconnectEpisodes.cs,
    plus the shared EntityRef.cs (linked, never copied).
    Run from the ModularSkiResort root:
      see the one-line command in the Program.cs header (XML comments cannot hold a double dash)
    Clone of tests/SlopeBatch/SlopeBatch.csproj. Lives OUTSIDE mod/SkiResortMod on purpose: the
    mod csproj globs **/*.cs, so a test host under it would be compiled into the net48 mod DLL.
    LangVersion pinned to the mod's 9.0 (Mod.props) so newer syntax in the linked files fails here
    too; net48 APIs are NOT gated here (net8 has Math.Clamp etc.); the mod build is the net48 API
    gate. UnityMathematics.NoDeps 1.3.2 matches the toolchain's com.unity.mathematics@1.3.2.
    The loop cache's GEOMETRY is not tested here (it needs Game types: Colossal.Mathematics, PathNode, Entity);
    since Catalog Phase C its topology pass is the pure LiftLoopTopology.cs, linked below (LoopCacheTests.cs).
    SkiCatalog (pure) is linked because StationAlign and LiftServedRule alias it; CatalogTests.cs holds
    CT-1 to CT-10 (the catalog's sanity, the frozen-name oracle, NAMES block and hub-literal text parses,
    and the resolver-lifetime decision table).
    CatalogTests.cs CT-1 to CT-16 (adds the carriers.json parse CT-11 with System.Text.Json, the gamedata-mirror
    drift CT-12, pending tokens CT-13, the BUILD-ITEMS table CT-14, the EvenSpacing arithmetic CT-15 and the
    sanity twin CT-16); LiftTypeTests.cs LT-1 to LT-10 (skeleton by core, body by the lift group).
    LiftLoopHold.cs
    (pure) linked; PowerGateTests.cs PG-0 to PG-4 and LoopHoldTests.cs LH-1 to LH-4.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>LiftBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftCensus.cs" Link="LiftCensus.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\StationAlign.cs" Link="StationAlign.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftReconnectEpisodes.cs" Link="LiftReconnectEpisodes.cs" />
    <!-- Round E1 (2026-10-04, econ-round spec ch2 §3.7): the served rule and the power predicate. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftServedRule.cs" Link="LiftServedRule.cs" />
    <!-- T137 S1 (2026-10-20): LiftClosedRule.NoOpenRunShare reads SkiMoneyRules' two shares. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiMoneyRules.cs" Link="SkiMoneyRules.cs" />
    <!-- Catalog Phase A -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="CatalogTests.cs" />
    <!-- Catalog Phase B (round-2-contract.md 11.1): the typed census / served-rule rows (body: the lift group). -->
    <Compile Include="LiftTypeTests.cs" />
    <!-- Catalog Phase C (round-3-contract.md 8.1, loopcache group): the loop cache's pure topology and the shuttle profile. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLoopTopology.cs" Link="LiftLoopTopology.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
    <Compile Include="LoopCacheReference.cs" />
    <Compile Include="LoopCacheTests.cs" />
    <Compile Include="ShuttleTests.cs" />
    <!-- Phase D (code-round-4/round-4-contract.md 7.1, rules group): the pure loop hold and the power-gate / hold tests. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLoopHold.cs" Link="LiftLoopHold.cs" />
    <!-- 2026-10-20 sim round (DECISIONS 347 d): the station LV icon rule, LoopHoldTests LV-1..LV-4. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\StationLvRule.cs" Link="StationLvRule.cs" />
    <Compile Include="PowerGateTests.cs" />
    <Compile Include="LoopHoldTests.cs" />
    <!-- Runs linked to a served run are served. -->
    <Compile Include="ServedLinkTests.cs" />
    <!-- The pure tower planner and its tests. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftTowerPlanner.cs" Link="LiftTowerPlanner.cs" />
    <Compile Include="LiftPlannerTests.cs" />
    <!-- The lift-line tool's pure edit model. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLineEdit.cs" Link="LiftLineEdit.cs" />
    <!-- The one lift tool's input rules + undo. -->
    <Compile Include="LiftToolInputTests.cs" />
    <!-- Per-tower number tiles, the pure core. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\TowerNumberTiles.cs" Link="TowerNumberTiles.cs" />
    <Compile Include="TowerNumberTests.cs" />
    <!-- The far-loop pace, bounds cadence and lane scope. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftMoverMath.cs" Link="LiftMoverMath.cs" />
    <Compile Include="LoopPaceTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
