<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MoverBench: the headless benchmark of the chair mover's MATH.
    Run from the ModularSkiResort root: see the one-line command in the Program.cs header.
    Unlike the *Batch hosts this one references the INSTALLED game's managed DLLs (CSII_MANAGEDPATH, set by the modding toolchain):
    LiftLoopCache.Sample and LiftLoopSampler need Colossal.Mathematics (Bezier4x3, ClampLength) and Game.Net.NetUtils.GetNodeRotation,
    so the benchmark runs the real code, not a transcription. Only pure math is executed (no Unity engine call), which loads fine
    on net8. The DLLs are copied into bin/ (gitignored, tests/**/bin/), never committed or redistributed. No EntityManager here:
    what a chair costs in the game on top of the math is a field number, not measured by this host.
    Lives OUTSIDE mod/SkiResortMod on purpose (the mod csproj globs **/*.cs). LangVersion 9.0 = the mod's.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>MoverBench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <GameManaged>$(CSII_MANAGEDPATH)</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLoopCache.cs" Link="LiftLoopCache.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLoopTopology.cs" Link="LiftLoopTopology.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftLoopSampler.cs" Link="LiftLoopSampler.cs" />
    <!-- the carrier grip round: the two-object pose and the swing (B-5) -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\CarrierPose.cs" Link="CarrierPose.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftMoverMath.cs" Link="LiftMoverMath.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\StationAlign.cs" Link="StationAlign.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Game"><HintPath>$(GameManaged)\Game.dll</HintPath></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(GameManaged)\Colossal.Mathematics.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(GameManaged)\Unity.Mathematics.dll</HintPath></Reference>
    <Reference Include="Unity.Entities"><HintPath>$(GameManaged)\Unity.Entities.dll</HintPath></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(GameManaged)\Unity.Collections.dll</HintPath></Reference>
    <Reference Include="Colossal.Core"><HintPath>$(GameManaged)\Colossal.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
