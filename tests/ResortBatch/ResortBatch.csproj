<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the pure U2 resort-data files (docs/research/hub-u2-spec.md §3.8):
    EntityRef.cs, SkiResortIndex.cs, SkiResortTourism.cs and SkiResortAggregate.cs (the "pure
    aggregation helpers" §3.8 names). Run from the ModularSkiResort root:
      see the one-line command in the Program.cs header (XML comments cannot hold a double dash)
    Clone of tests/SlopeBatch/SlopeBatch.csproj. Lives OUTSIDE mod/SkiResortMod on purpose: the
    mod csproj globs **/*.cs, so a test host under it would be compiled into the net48 mod DLL.
    LangVersion pinned to the mod's 9.0 (Mod.props) so newer syntax in the linked files fails here
    too; net48 APIs are NOT gated here (the mod build is the net48 API gate).
    UnityMathematics.NoDeps 1.3.2 matches the toolchain's com.unity.mathematics@1.3.2.
    Created 2026-10-03 (Round U2, implementer I-1).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ResortBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortIndex.cs" Link="SkiResortIndex.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortTourism.cs" Link="SkiResortTourism.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortAggregate.cs" Link="SkiResortAggregate.cs" />
    <!-- U2 fixer round (2026-10-03): the rating cache's key / queue / band rules (findings u2-data-01,
         behavior-2, u2-data-05). -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunRatingRules.cs" Link="SkiRunRatingRules.cs" />
    <!-- Round F6 (2026-10-03, implementer A): the hub's "camera already on the sign" rule (A1 / A2). -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\HubCameraRules.cs" Link="HubCameraRules.cs" />
  </ItemGroup>
  <!-- ROUND E1 (2026-10-04, econ-round e1-spec.md §4.1): the E1 pure files and their tests. -->
  <ItemGroup>
    <Compile Include="ScoreTests.cs" />
    <Compile Include="RatingServiceTests.cs" />
    <Compile Include="SnowRulesTests.cs" />
    <Compile Include="MoneyBatch.cs" />
    <Compile Include="HubRulesTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortScore.cs" Link="SkiResortScore.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunSnowRules.cs" Link="RunSnowRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiMoneyRules.cs" Link="SkiMoneyRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortLedger.cs" Link="SkiResortLedger.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftServedRule.cs" Link="LiftServedRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\HubRules.cs" Link="HubRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\PisteMapRules.cs" Link="PisteMapRules.cs" />
    <!-- Catalog Phase A (2026-10-11, catalog-a/phase-a-contract.md C6/C7): the pure catalog the rule files above
         alias (SkiResortScore, SkiMoneyRules, LiftServedRule, HubRules; SkiDayRules below), and its guard. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="CatalogGuardTests.cs" />
  </ItemGroup>
  <!-- Catalog Phase B (2026-10-11, docs/research/art/assets-2026-10/code-round-2/round-2-contract.md 7.2 / 11.2): the
       economy group's new pure files (SchoolRule.cs, PatrolRule.cs) are linked ONLY when they exist, so the host builds
       and runs before that group lands (CatalogGuardTests prints "not landed yet" until then); LadderTests.cs holds the
       ladder / school / patrol / ledger rows (skeleton by core, body by the economy group). -->
  <ItemGroup>
    <Compile Include="LadderTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SchoolRule.cs" Link="SchoolRule.cs" Condition="Exists('..\..\mod\SkiResortMod\Systems\SchoolRule.cs')" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\PatrolRule.cs" Link="PatrolRule.cs" Condition="Exists('..\..\mod\SkiResortMod\Systems\PatrolRule.cs')" />
  </ItemGroup>
  <!-- Catalog Phase C (2026-10-11, docs/research/art/assets-2026-10/code-round-3/round-3-contract.md 8.3, rules group): the
       tram's pure shuttle profile, which HubRules.ShuttleRideTimeS / ShuttleCapacityPerHour call (HubRulesTests section J).
       Pure: System + Unity.Mathematics (the package below). -->
  <ItemGroup>
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
  </ItemGroup>
  <!-- ROUND F7 (2026-10-04, docs/research/field-test-7-fixes.md C1, implementer 2): the run outline overlay's rules. -->
  <ItemGroup>
    <Compile Include="RunOutlineTests.cs" />
    <!-- T37 (2026-10-16): the run-name labels' pure rules. -->
    <Compile Include="RunLabelTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunLabelRules.cs" Link="RunLabelRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunOutlineRules.cs" Link="RunOutlineRules.cs" />
  </ItemGroup>
  <!-- ROUND S1 ski days (docs/research/ski-days/s1-spec.md §4.2) -->
  <ItemGroup>
    <Compile Include="SkiDayTests.cs" />
    <Compile Include="SkiDayTimingTests.cs" />
    <Compile Include="ParkingTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiDayRules.cs" Link="SkiDayRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiDayTiming.cs" Link="SkiDayTiming.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiParkingRules.cs" Link="SkiParkingRules.cs" />
  </ItemGroup>
  <!-- ROUND M2 (docs/research/round-m2/build-contract.md) -->
  <ItemGroup>
    <Compile Include="DensityTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunPropDensityRules.cs" Link="RunPropDensityRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiTripSystems.cs" Link="SkiTripSystems.cs" />
  </ItemGroup>
  <!-- Phase D (2026-10-11, docs/research/art/assets-2026-10/code-round-4/round-4-contract.md 7.2, rules group): unpowered
       lifts are inert. UnpoweredTests.cs UP-1 to UP-6 over the files linked above (LiftServedRule, SkiResortScore, PatrolRule,
       SchoolRule, SkiMoneyRules, SkiDayRules); HubRulesTests.cs gains section K. No new linked file. -->
  <ItemGroup>
    <Compile Include="UnpoweredTests.cs" />
  </ItemGroup>
  <!-- T54 probe 1 (2026-10-16, docs/research/field/2026-10-15/build/T54-probe1-overlap.md): the cat track's pure rules (CT54-1 to
       CT54-7: kinds, leaf, unsuitable, exclusions, snow, props, catalog) over files linked above. No new linked file. -->
  <ItemGroup>
    <Compile Include="CatTrackTests.cs" />
  </ItemGroup>
  <!-- T46 (2026-10-17, docs/research/field/2026-10-15/build/T46-snow-gun-plume.md): the guns-running predicate shared by the
       snow injection and the plume system (GP-1 to GP-6). -->
  <ItemGroup>
    <Compile Include="SnowGunPlumeTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SnowGunPlumeRules.cs" Link="SnowGunPlumeRules.cs" />
  </ItemGroup>
  <!-- T78 build 1 (2026-10-18, docs/research/ui/hub-history-build-1-2026-10-18.md): the hub history store's pure file (ring ops,
       seasons, codecs, the run-upkeep split) and the ledger's P3 / P4 rows (H-1 to H-9). SkiResortLedger.cs is linked above. -->
  <ItemGroup>
    <Compile Include="HistoryTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortHistory.cs" Link="SkiResortHistory.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
