<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the pure resort-data files: EntityRef.cs, SkiResortIndex.cs, SkiResortTourism.cs and SkiResortAggregate.cs
    (the pure aggregation helpers), plus the rule files linked below. Run from the ModularSkiResort root: see the one-line command
    in the Program.cs header.
    Lives OUTSIDE mod/SkiResortMod on purpose: the mod csproj globs **/*.cs, so a test host under it would be compiled into
    the net48 mod DLL. LangVersion pinned to the mod's 9.0 (Mod.props) so newer syntax in the linked files fails here too;
    net48 APIs are NOT gated here (the mod build is the net48 API gate).
    UnityMathematics.NoDeps 1.3.2 matches the toolchain's com.unity.mathematics@1.3.2.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ResortBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortIndex.cs" Link="SkiResortIndex.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortTourism.cs" Link="SkiResortTourism.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortAggregate.cs" Link="SkiResortAggregate.cs" />
    <!-- The rating cache's key / queue / band rules. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunRatingRules.cs" Link="SkiRunRatingRules.cs" />
    <!-- The hub's "camera already on the sign" rule. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\HubCameraRules.cs" Link="HubCameraRules.cs" />
  </ItemGroup>
  <!-- The economy pure files and their tests. -->
  <ItemGroup>
    <Compile Include="ScoreTests.cs" />
    <Compile Include="RatingServiceTests.cs" />
    <Compile Include="SnowRulesTests.cs" />
    <Compile Include="MoneyBatch.cs" />
    <Compile Include="HubRulesTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortScore.cs" Link="SkiResortScore.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunSnowRules.cs" Link="RunSnowRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiMoneyRules.cs" Link="SkiMoneyRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortLedger.cs" Link="SkiResortLedger.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftServedRule.cs" Link="LiftServedRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\HubRules.cs" Link="HubRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\PisteMapRules.cs" Link="PisteMapRules.cs" />
    <!-- The pure catalog the rule files above alias (SkiResortScore, SkiMoneyRules, LiftServedRule, HubRules; SkiDayRules below), and its guard. -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="CatalogGuardTests.cs" />
    <Compile Include="DeleteAllTests.cs" />
    <Compile Include="SkiBusTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\DeleteAllRules.cs" Link="DeleteAllRules.cs" />
  </ItemGroup>
  <!--
    SchoolRule.cs and PatrolRule.cs are linked ONLY when they exist, so the host builds before they do (CatalogGuardTests prints
    "not landed yet" until then); LadderTests.cs holds the ladder / school / patrol / ledger rows.
  -->
  <ItemGroup>
    <Compile Include="LadderTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SchoolRule.cs" Link="SchoolRule.cs" Condition="Exists('..\..\mod\SkiResortMod\Systems\SchoolRule.cs')" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\PatrolRule.cs" Link="PatrolRule.cs" Condition="Exists('..\..\mod\SkiResortMod\Systems\PatrolRule.cs')" />
  </ItemGroup>
  <!-- The tram's pure shuttle profile, which HubRules.ShuttleRideTimeS / ShuttleCapacityPerHour call (HubRulesTests section J).
       Pure: System + Unity.Mathematics (the package below). -->
  <ItemGroup>
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
  </ItemGroup>
  <!-- The run outline overlay's rules. -->
  <ItemGroup>
    <Compile Include="RunOutlineTests.cs" />
    <!-- The run-name labels' pure rules. -->
    <Compile Include="RunLabelTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunLabelRules.cs" Link="RunLabelRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunOutlineRules.cs" Link="RunOutlineRules.cs" />
  </ItemGroup>
  <!-- Ski days -->
  <ItemGroup>
    <Compile Include="SkiDayTests.cs" />
    <Compile Include="SkiDayTimingTests.cs" />
    <Compile Include="ParkingTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiDayRules.cs" Link="SkiDayRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiBusRules.cs" Link="SkiBusRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiDayTiming.cs" Link="SkiDayTiming.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiParkingRules.cs" Link="SkiParkingRules.cs" />
  </ItemGroup>
  <!-- Snow groomer: trip, season gate, restraint, ground plane, smoothing, pose, centerline of hand-drawn rings. GradeBatch GR-30 runs generated ribbons. -->
  <ItemGroup>
    <Compile Include="GroomerTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\GroomerRules.cs" Link="GroomerRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\GroomerCenterline.cs" Link="GroomerCenterline.cs" />
  </ItemGroup>
  <!-- Run prop density -->
  <ItemGroup>
    <Compile Include="DensityTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\RunPropDensityRules.cs" Link="RunPropDensityRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiTripSystems.cs" Link="SkiTripSystems.cs" />
  </ItemGroup>
  <!--
    Unpowered lifts are inert: UnpoweredTests.cs UP-1 to UP-6 over the files linked above (LiftServedRule, SkiResortScore, PatrolRule,
    SchoolRule, SkiMoneyRules, SkiDayRules); HubRulesTests.cs section K.
  -->
  <ItemGroup>
    <Compile Include="UnpoweredTests.cs" />
  </ItemGroup>
  <!-- The cat track's pure rules (CT54-1 to
       CT54-7 and CT139: kinds, leaf, open state, minimal weight, green rule, snow, props, catalog) over files linked above. No new linked file. -->
  <ItemGroup>
    <Compile Include="CatTrackTests.cs" />
  </ItemGroup>
  <!-- The guns-running predicate shared by the
       snow injection and the plume system (GP-1 to GP-6). -->
  <ItemGroup>
    <Compile Include="SnowGunPlumeTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SnowGunPlumeRules.cs" Link="SnowGunPlumeRules.cs" />
  </ItemGroup>
  <!-- The hub history store's pure file (ring ops,
       seasons, codecs, the run-upkeep split) and the ledger's P3 / P4 rows (H-1 to H-9). SkiResortLedger.cs is linked above. -->
  <ItemGroup>
    <Compile Include="HistoryTests.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortHistory.cs" Link="SkiResortHistory.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
