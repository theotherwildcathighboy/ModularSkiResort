<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless test host for the save format (T74, 2026-10-19; docs/research/release-scaffolds-2026-10-19.md): every persisted
    type's layout against the frozen table SaveLayouts.cs, the [FormerlySerializedAs] self-aliases and the pinned
    AssemblyVersion of the BUILT mod DLL, and the release/CHANGELOG.md layout line. Run from the ModularSkiResort root:
      see the one-line command in the Program.cs header (XML comments cannot hold a double dash)
    Lives OUTSIDE mod/SkiResortMod on purpose (the mod csproj globs **/*.cs). The three component files are linked
    UNCHANGED against EngineShims.cs (same namespaces as Colossal.Core / Unity.Entities, scalar members only); the two
    history types through their pure codec (SkiResortHistory.cs) and its pure dependencies, as tests/ResortBatch links them.
    LangVersion pinned to the mod's 9.0; UnityMathematics.NoDeps 1.3.2 = the toolchain's com.unity.mathematics@1.3.2.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>SaveBatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LayoutTests.cs" />
    <Compile Include="DllAliasTests.cs" />
    <Compile Include="ChangelogTests.cs" />
    <Compile Include="EngineShims.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SaveLayouts.cs" Link="SaveLayouts.cs" />
    <!-- the persisted types -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunBinding.cs" Link="SkiRunBinding.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunTreeMember.cs" Link="SkiRunTreeMember.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiSeasonPass.cs" Link="SkiSeasonPass.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortHistory.cs" Link="SkiResortHistory.cs" />
    <!-- SkiResortHistory.cs's pure dependencies (the same files tests/ResortBatch links) -->
    <Compile Include="..\..\mod\SkiResortMod\Systems\EntityRef.cs" Link="EntityRef.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortLedger.cs" Link="SkiResortLedger.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiMoneyRules.cs" Link="SkiMoneyRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\HubRules.cs" Link="HubRules.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiCatalog.cs" Link="SkiCatalog.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\ShuttleProfile.cs" Link="ShuttleProfile.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\LiftServedRule.cs" Link="LiftServedRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiResortScore.cs" Link="SkiResortScore.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\PatrolRule.cs" Link="PatrolRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SchoolRule.cs" Link="SchoolRule.cs" />
    <Compile Include="..\..\mod\SkiResortMod\Systems\SkiRunRatingRules.cs" Link="SkiRunRatingRules.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
